auto export_node_fields(const node_model::unified_node& source) -> json {
    auto result = json::object();
    switch (source.core.protocol) {
    case node_model::protocol_type::shadowsocks:
        result = export_proxy_ss_root(source);
        result["type"] = "ss";
        merge_export(result, export_plugin_obfs_root(source));
        merge_export(result, export_plugin_v2ray_plugin_root(source));
        merge_export(result, export_plugin_gost_plugin_root(source));
        merge_export(result, export_plugin_shadow_tls_root(source));
        merge_export(result, export_plugin_restls_root(source));
        merge_export(result, export_plugin_jls_root(source));
        merge_export(result, export_plugin_kcptun_root(source));
        break;
    case node_model::protocol_type::shadowsocksr:
        result = export_proxy_ssr_root(source);
        result["type"] = "ssr";
        break;
    case node_model::protocol_type::socks5:
        result = export_proxy_socks5_root(source);
        result["type"] = "socks5";
        break;
