    if (source.configuration != nullptr && std::holds_alternative<node_model::mekya_transport>(
                                               (*source.configuration).link.transport)) {
        emit_object(result, "mekya-opts",
                    export_proxy_vmess_root_mekya_opts(std::get<node_model::mekya_transport>(
                        (*source.configuration).link.transport)),
                    false);
    }
    if (source.configuration != nullptr && std::holds_alternative<node_model::mkcp_transport>(
                                               (*source.configuration).link.transport)) {
        emit_object(result, "mkcp-opts",
                    export_proxy_vmess_root_mkcp_opts(std::get<node_model::mkcp_transport>(
                        (*source.configuration).link.transport)),
