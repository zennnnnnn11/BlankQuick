        break;
    case node_model::protocol_type::tailscale:
        result = export_proxy_tailscale_root(source);
        result["type"] = "tailscale";
        break;
    case node_model::protocol_type::zerotier:
        result = export_proxy_zerotier_root(source);
        result["type"] = "zerotier";
        break;
    case node_model::protocol_type::easytier:
        result = export_proxy_easytier_root(source);
        result["type"] = "easytier";
        break;
    case node_model::protocol_type::unspecified:
        fail(configuration_error::invalid_node);
    }
    return result;
