auto export_proxy_vmess_root_part_0(json& result, const node_model::unified_node& source) -> void {
    if (source.configuration != nullptr) {
        write_field(result, "tfo", (*source.configuration).link.tcp_fast_open, false, false);
        write_field(result, "mptcp", (*source.configuration).link.multipath_tcp, false, false);
        write_field(result, "interface-name", (*source.configuration).link.interface_name, false,
                    false);
        write_field(result, "routing-mark", (*source.configuration).link.routing_mark, false,
                    false);
        write_field(result, "ip-version", (*source.configuration).link.ip_policy, false, false);
        write_field(result, "dialer-proxy", (*source.configuration).link.dialer_proxy, false,
                    false);
    }
    write_field(result, "name", source.core.name, true, false);
    if (source.core.remote != std::nullopt) {
        write_field(result, "server", source.core.remote.value().host, true, false);
        write_field(result, "port", source.core.remote.value().port, true, false);
    }
    if (source.configuration != nullptr &&
        std::holds_alternative<node_model::vmess_param>((*source.configuration).detail)) {
        write_field(result, "uuid",
                    std::get<node_model::vmess_param>((*source.configuration).detail).uuid, true,
                    false);
        write_field(result, "alterId",
                    std::get<node_model::vmess_param>((*source.configuration).detail).alter_id,
                    true, false);
        write_field(result, "cipher",
                    std::get<node_model::vmess_param>((*source.configuration).detail).cipher, true,
                    false);
    }
}

