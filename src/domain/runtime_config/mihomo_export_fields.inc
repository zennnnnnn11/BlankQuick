        result = export_proxy_masque_root(source);
        result["type"] = "masque";
        break;
    case node_model::protocol_type::trusttunnel:
        result = export_proxy_trusttunnel_root(source);
        result["type"] = "trusttunnel";
        break;
    case node_model::protocol_type::openvpn:
