auto bind_plugin_kcptun(options& source, node_configuration& configuration) -> void {
    if (std::holds_alternative<node_model::kcptun_plugin_param>(
            std::get<node_model::shadowsocks_param>(configuration.detail).plugin)) {
        bind_plugin_kcptun_group_0_part_0(source, configuration);
        bind_plugin_kcptun_group_0_part_1(source, configuration);
        bind_plugin_kcptun_group_0_part_2(source, configuration);
    }
}

auto bind_kernel_fields(options& source, node_configuration& configuration, uri_protocol protocol)
    -> void {
    switch (protocol) {
    case uri_protocol::shadowsocks:
        bind_proxy_ss(source, configuration);
        bind_plugin_obfs(source, configuration);
        bind_plugin_v2ray_plugin(source, configuration);
        bind_plugin_gost_plugin(source, configuration);
        bind_plugin_shadow_tls(source, configuration);
        bind_plugin_restls(source, configuration);
        bind_plugin_jls(source, configuration);
        bind_plugin_kcptun(source, configuration);
        break;
    case uri_protocol::vmess:
        bind_proxy_vmess(source, configuration);
        break;
    case uri_protocol::vless:
        bind_proxy_vless(source, configuration);
        break;
    case uri_protocol::trojan:
        bind_proxy_trojan(source, configuration);
        break;
    case uri_protocol::hysteria2:
        bind_proxy_hysteria2(source, configuration);
        break;
    case uri_protocol::tuic:
        bind_proxy_tuic(source, configuration);
        break;
    case uri_protocol::wireguard:
        bind_proxy_wireguard(source, configuration);
        break;
    case uri_protocol::anytls:
        bind_proxy_anytls(source, configuration);
        break;
    case uri_protocol::unspecified:
        fail(parse_error::unsupported_protocol);
    }
}
