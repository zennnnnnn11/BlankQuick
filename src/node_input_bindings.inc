        read_value(*value, configuration.link.tcp_fast_open);
    }
    if (const auto* value = find_option(source, "mptcp")) {
        read_value(*value, configuration.link.multipath_tcp);
    }
    if (const auto* value = find_option(source, "interface-name")) {
        read_value(*value, configuration.link.interface_name);
    }
    if (const auto* value = find_option(source, "routing-mark")) {
        read_value(*value, configuration.link.routing_mark);
    }
    if (const auto* value = find_option(source, "ip-version")) {
        read_value(*value, configuration.link.ip_policy);
    }
    if (const auto* value = find_option(source, "dialer-proxy")) {
        read_value(*value, configuration.link.dialer_proxy);
    }
    if (const auto* value = find_option(source, "password")) {
        read_value(*value, std::get<node_model::anytls_param>(configuration.detail).password);
    }
    if (const auto* value = find_option(source, "alpn")) {
        read_value(*value, configuration.link.security.tls.alpn);
    }
    if (const auto* value = find_option(source, "sni")) {
        read_value(*value, configuration.link.security.tls.server_name);
    }
    if (const auto* value = find_option(source, "ech-opts.enable")) {
        read_value(*value, present(configuration.link.security.ech).enable);
    }
    if (const auto* value = find_option(source, "ech-opts.config")) {
        read_value(*value, present(configuration.link.security.ech).config);
    }
    if (const auto* value = find_option(source, "ech-opts.query-server-name")) {
        read_value(*value, present(configuration.link.security.ech).query_server_name);
    }
}

