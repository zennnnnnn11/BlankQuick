# The allowlist is shared with source/CTest checks. Validate after all directories
# and Qt-generated targets exist, so a transitive dependency cannot hide a breach.
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${PROJECT_SOURCE_DIR}/tools/architecture.json")

function(blank_check_dependency policy target dependency)
    if(dependency MATCHES "^\\$<(LINK_ONLY|BUILD_INTERFACE|TARGET_NAME_IF_EXISTS):([^<>]+)>$")
        set(dependency "${CMAKE_MATCH_2}")
    endif()
    if(TARGET "${dependency}")
        get_target_property(alias "${dependency}" ALIASED_TARGET)
        if(alias)
            set(dependency "${alias}")
        endif()
    endif()
    # Qt creates private resource/cache targets for this one UI executable.
    if(target STREQUAL "blank_quick" AND dependency MATCHES "^blank_quick_")
        return()
    endif()
    string(JSON allowed GET "${policy}" target_dependencies "${target}")
    string(JSON count LENGTH "${allowed}")
    set(found FALSE)
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE ${last})
            string(JSON entry GET "${allowed}" ${index})
            if(entry STREQUAL dependency)
                set(found TRUE)
                break()
            endif()
        endforeach()
    endif()
    if(NOT found)
        message(FATAL_ERROR "Architecture: ${target} -> ${dependency} is not an allowed dependency.")
    endif()

    string(JSON layer GET "${policy}" target_layers "${target}")
    string(JSON other ERROR_VARIABLE missing GET "${policy}" target_layers "${dependency}")
    if(NOT missing)
        string(JSON layers GET "${policy}" layers "${layer}")
        string(JSON count LENGTH "${layers}")
        math(EXPR last "${count} - 1")
        foreach(index RANGE ${last})
            string(JSON permitted GET "${layers}" ${index})
            if(permitted STREQUAL other)
                return()
            endif()
        endforeach()
        message(FATAL_ERROR "Architecture: ${layer} target ${target} cannot depend on ${other} target ${dependency}.")
    endif()
    if(layer MATCHES "^(domain|shared|vendor)$" AND NOT dependency STREQUAL "Qt6::Core")
        message(FATAL_ERROR "Architecture: data target ${target} cannot link external library ${dependency}.")
    endif()
endfunction()

function(blank_check_directory policy directory)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
        get_target_property(type "${target}" TYPE)
        if(type STREQUAL "UTILITY")
            continue()
        endif()
        string(JSON layer ERROR_VARIABLE missing GET "${policy}" target_layers "${target}")
        if(missing)
            if(target MATCHES "^blank_quick_")
                continue()
            endif()
            message(FATAL_ERROR "Architecture: register build target ${target} in tools/architecture.json.")
        endif()
        if(layer STREQUAL "domain" AND NOT type STREQUAL "INTERFACE_LIBRARY")
            target_include_directories("${target}" BEFORE PRIVATE "${PROJECT_BINARY_DIR}/data-boundary")
        endif()
        foreach(property IN ITEMS LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
            get_target_property(dependencies "${target}" "${property}")
            if(dependencies)
                foreach(dependency IN LISTS dependencies)
                    blank_check_dependency("${policy}" "${target}" "${dependency}")
                endforeach()
            endif()
        endforeach()
    endforeach()
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        blank_check_directory("${policy}" "${child}")
    endforeach()
endfunction()

function(blank_create_data_fence)
    # Private to domain targets: effects remain available to platform/app code.
    # Generate these wrappers in the build tree rather than maintaining dozens
    # of identical source headers. A macro-based #include hits the same fence.
    set(headers windows.h winsock2.h ws2tcpip.h winbase.h winuser.h processthreadsapi.h
        iphlpapi.h setupapi.h wininet.h bcrypt.h)
    foreach(type IN ITEMS QFile QFileInfo QDir QDirIterator QLockFile QSaveFile
            QProcess QProcessEnvironment QTimer QThread
            QCoreApplication QStandardPaths QTemporaryDir QTemporaryFile)
        string(TOLOWER "${type}" lower)
        list(APPEND headers "${type}" "QtCore/${type}" "QtCore/${lower}.h")
    endforeach()
    # Qt includes UUID/random value declarations internally. Entropy-producing
    # calls are checked in authored source; those value headers cannot be shadowed.
    set(manifest "${PROJECT_BINARY_DIR}/data-boundary/headers.txt")
    if(EXISTS "${manifest}")
        file(STRINGS "${manifest}" previous)
        foreach(header IN LISTS previous)
            if(IS_ABSOLUTE "${header}" OR header MATCHES "(^|/)\\.\\.(/|$)")
                message(FATAL_ERROR "Invalid generated data-boundary manifest entry.")
            endif()
            if(NOT header IN_LIST headers)
                file(REMOVE "${PROJECT_BINARY_DIR}/data-boundary/${header}")
            endif()
        endforeach()
    endif()
    foreach(header IN LISTS headers)
        get_filename_component(directory "${PROJECT_BINARY_DIR}/data-boundary/${header}" DIRECTORY)
        file(MAKE_DIRECTORY "${directory}")
        set(content "#error BLANK_DATA_BOUNDARY: ${header} is an effect API; use an application/platform adapter.\n")
        # configure_file preserves timestamps when the wrapper is unchanged.
        file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/data-boundary/${header}" CONTENT "${content}")
    endforeach()
    list(JOIN headers "\n" manifest_content)
    file(CONFIGURE OUTPUT "${manifest}" CONTENT "${manifest_content}\n")
endfunction()

function(blank_enforce_architecture)
    file(READ "${PROJECT_SOURCE_DIR}/tools/architecture.json" policy)
    blank_create_data_fence()
    blank_check_directory("${policy}" "${PROJECT_SOURCE_DIR}")
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/check_lint_comments.py"
        WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}" COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/check_architecture.py"
        --includes-only WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
        COMMAND_ERROR_IS_FATAL ANY)
endfunction()
