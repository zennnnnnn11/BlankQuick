---
Checks: >-
  -*,
  clang-analyzer-*,
  bugprone-*,
  cert-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-function-cognitive-complexity,
  -readability-function-size
WarningsAsErrors: '*'
HeaderFilterRegex: '[/\\]src[/\\](platform[/\\](windows|storage|config|process|environment|protocol|ipc|tun|kernel|system_proxy|telemetry|qt)|services|application[/\\]runtime|domain[/\\]service_config)[/\\]'
SystemHeaders: false
FormatStyle: file
CheckOptions:
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.FunctionCase: camelBack
  readability-identifier-naming.VariableCase: camelBack
  readability-identifier-naming.PrivateMemberSuffix: '_'
  modernize-use-nodiscard.ReplacementString: '[[nodiscard]]'
...
